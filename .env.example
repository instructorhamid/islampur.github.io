# ---------------------------------------------------------------------------
# Islampur High School Reunion — environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix except the site URL).
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string (server-only).
# Supabase: "Connect" → Transaction pooler URI. If unset, POSTGRES_URL (set by the
# Vercel ⇄ Supabase integration) is used instead; SSL is enabled automatically for Supabase/Neon.
DATABASE_URL=postgres://reunion:reunion@localhost:5432/reunion
# "require" or "disable" to override automatic SSL detection. Usually leave empty.
DATABASE_SSL=
# Max pooled connections per server instance (use 1–3 on serverless hosts).
DATABASE_POOL_MAX=5

# Secret used to hash IP addresses for rate limiting. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# One-time code for creating the first admin at /admin/setup (≥16 characters).
# The page locks itself once an admin exists; you can remove this afterwards.
SETUP_TOKEN=

# Where uploaded photos and sponsor logos are stored: "local" or "supabase".
# If unset: "supabase" when SUPABASE_URL and a service key are present, otherwise "local".
#   local    — files are written to LOCAL_UPLOAD_DIR (good for development and VPS hosting;
#              does NOT work on read-only serverless hosts such as Vercel).
#   supabase — files go to a PRIVATE Supabase Storage bucket and are served through the app,
#              which enforces approval and consent rules.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# Supabase Storage (server-only, keep secret). Set automatically by the Vercel integration.
# SUPABASE_SECRET_KEY is accepted instead of SUPABASE_SERVICE_ROLE_KEY. The private bucket is
# created automatically on first upload.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reunion-media

# Maximum accepted upload size in megabytes (photos are compressed in the browser first).
# Vercel limits request bodies to 4.5 MB, so keep this at 4 or lower there.
MAX_UPLOAD_MB=4
