{
  "name": "islampur-reunion",
  "version": "1.0.0",
  "private": true,
  "description": "Islampur High School (Chhatak, Sunamganj) alumni reunion website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:clear-demo": "tsx scripts/clear-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/reset-db.ts && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "vercel-build": "npm run db:migrate && next build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "next": "^15.5.27",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    }
  }
}
